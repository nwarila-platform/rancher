# =========================================================================================== #
# File: '.gitignore'
# --- [ Description ] ----------------------------------------------------------------------- #
#
# DEFAULT-DENY, EXPLICIT INCLUDES ONLY. Nothing in this working tree is tracked unless it is
# explicitly allowed below, by name — no wildcard allowances. Adding a new file therefore
# requires allowing it here first — that is deliberate: it makes publishing a file an
# explicit act rather than an accident.
#
# =========================================================================================== #

# Ignore everything ...
**

# --- [ directory spine ] -------------------------------------------------------------------- #
# Git does not descend into an excluded directory, so every directory on the path to an
# allowed file is re-included by name. This publishes no files by itself: files inside these
# directories stay ignored until named in a section below.
!/.github/
!/.github/workflows/
!/ansible/
!/ansible/applications/
!/ansible/applications/rke2/
!/ansible/applications/rke2/defaults/
!/ansible/applications/rke2/meta/
!/ansible/applications/rke2/tasks/
!/ansible/applications/rke2/templates/
!/ansible/applications/rke2/vars/
!/ansible/inventory/
!/ansible/playbooks/
!/dependencies/
!/dependencies/aws/
!/dependencies/aws/policies/
!/dependencies/aws/roles/
!/scripts/
!/terraform/

# --- [ allowed: repository configuration ] -------------------------------------------------- #
!/.editorconfig
!/.framework-pin
!/.gitignore
!/.yamllint.yml

# --- [ allowed: top-level documents ] ------------------------------------------------------- #
!/LICENSE
!/README.md
!/SECURITY.md
!/quality-tools.env
!/requirements-quality.txt
!/requirements-quality.yml

# --- [ allowed: GitHub configuration ] ------------------------------------------------------ #
!/.github/CODEOWNERS
!/.github/renovate.json5
!/.github/terraform-framework-pin
!/.github/workflows/aws-deploy.yml
!/.github/workflows/aws-reaper.yml
!/.github/workflows/powershell.yml
!/.github/workflows/quality.yml

# --- [ allowed: the ansible tree ] ---------------------------------------------------------- #
!/ansible/applications/rke2/README.md
!/ansible/applications/rke2/defaults/main.yml
!/ansible/applications/rke2/meta/main.yml
!/ansible/applications/rke2/tasks/main.yml
!/ansible/applications/rke2/tasks/present_redhat.yml
!/ansible/applications/rke2/tasks/validate.yml
!/ansible/applications/rke2/templates/audit-policy.yaml.j2
!/ansible/applications/rke2/templates/config.yaml.j2
!/ansible/applications/rke2/templates/rke2-pss-custom.yaml.j2
!/ansible/applications/rke2/vars/redhat.yml
!/ansible/inventory/README.md
!/ansible/inventory/aws_ec2.yml
!/ansible/playbooks/rancher-aws.yml

# --- [ allowed: dependency declarations ] -------------------------------------------------- #
!/dependencies/MANIFEST.sha256
!/dependencies/README.md
!/dependencies/registry-values.yml
!/dependencies/aws/artifacts.yml
!/dependencies/aws/estate.yml
!/dependencies/aws/manifest.json
!/dependencies/aws/policies/nwarila-platform_rancher_admin_s3.json
!/dependencies/aws/policies/nwarila-platform_rancher_reaper_ebs.json
!/dependencies/aws/policies/nwarila-platform_rancher_reaper_ec2.json
!/dependencies/aws/policies/nwarila-platform_rancher_reaper_elb.json
!/dependencies/aws/policies/nwarila-platform_rancher_reaper_eni.json
!/dependencies/aws/policies/nwarila-platform_rancher_reaper_iam.json
!/dependencies/aws/policies/nwarila-platform_rancher_reaper_s3.json
!/dependencies/aws/policies/nwarila-platform_rancher_reaper_sg.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_ebs.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_ec2.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_elb.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_eni.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_iam.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_kms.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_s3.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_sg.json
!/dependencies/aws/policies/nwarila-platform_rancher_runner_ssm.json
!/dependencies/aws/roles/nwarila-platform_rancher_admin.trust.json
!/dependencies/aws/roles/nwarila-platform_rancher_admin.yml
!/dependencies/aws/roles/nwarila-platform_rancher_reaper.trust.json
!/dependencies/aws/roles/nwarila-platform_rancher_reaper.yml
!/dependencies/aws/roles/nwarila-platform_rancher_runner.trust.json
!/dependencies/aws/roles/nwarila-platform_rancher_runner.yml

# --- [ allowed: scripts ] ------------------------------------------------------------------- #
!/scripts/apply-dependencies.sh
!/scripts/check-dependencies.py
!/scripts/compose-and-run.sh
!/scripts/materialize-role-scripts.sh

# --- [ allowed: terraform (data-only; resources live in the pinned framework) ] -------------- #
!/terraform/README.md
!/terraform/aws.tfvars
