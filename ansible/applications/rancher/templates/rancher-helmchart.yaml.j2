# Managed by the rancher role; RKE2's helm-controller installs and upgrades from it.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: rancher
  namespace: kube-system
spec:
  repo: {{ config.chart_repo | to_json }}
  chart: rancher
  version: {{ config.version | to_json }}
  targetNamespace: {{ config.namespace | to_json }}
  createNamespace: true
  valuesContent: |-
    hostname: {{ config.hostname | to_json }}
    replicas: {{ config.replicas }}
    bootstrapPassword: {{ config.bootstrap_password | to_json }}
    agentTLSMode: strict
    # V-257292: a private CA's certificate, from the tls-rancher-ingress and tls-ca secrets.
    privateCA: true
    # V-252849: the ingress reaches Rancher over TLS on 443, never plain HTTP on 80. Traefik takes
    # its backend transport from rancher-stig.yaml, named on the Service.
    service:
      annotations:
        traefik.ingress.kubernetes.io/service.serverstransport: "{{ config.namespace }}-rancher-backend@kubernetescrd"
    ingress:
      ingressClassName: {{ config.ingress_class | to_json }}
      servicePort: 443
      extraAnnotations:
        traefik.ingress.kubernetes.io/router.tls: "true"
      tls:
        source: secret
    # V-252844
    auditLog:
      enabled: true
      level: {{ config.audit_level }}
      destination: sidecar
